<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.CALL_PHONE" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <service
      android:name="expo.modules.callkittelecom.services.CallMicrophoneService"
      android:exported="false"
      android:foregroundServiceType="microphone" />

    <service
      android:name="expo.modules.callkittelecom.telecom.ManagedConnectionService"
      android:exported="true"
      android:label="@string/app_name"
      android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
      <intent-filter>
        <action android:name="android.telecom.ConnectionService" />
      </intent-filter>
    </service>

    <service
      android:name="expo.modules.callkittelecom.services.ExpoCallKitTelecomMessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>

    <service
      android:name="expo.modules.callkittelecom.services.ExpoCallKitTelecomHeadlessService"
      android:exported="false" />
  </application>
</manifest>
